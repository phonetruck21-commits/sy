{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SY Live Service",
  "version": "0.1.0",
  "identifier": "il.co.sy.liveservice",
  "build": {
    "frontendDist": "../../web/dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../web", "wait": false },
    "beforeBuildCommand": { "script": "npm run build:desktop", "cwd": "../../web" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "S.Y LIVE SERVICE – עמדת טכנאי",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "S.Y",
    "shortDescription": "S.Y LIVE SERVICE technician workstation",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["Hebrew", "English"], "displayLanguageSelector": false, "installMode": "perMachine" },
      "wix": { "language": ["he-IL", "en-US"] }
    }
  }
}
