# העתיקו לקובץ בשם .env ומלאו את הפרטים מ-https://developer.paypal.com/dashboard/applications
# (Apps & Credentials → צרו אפליקציה → Client ID + Secret)

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# sandbox = מצב בדיקות (כסף לא אמיתי). כשהכול עובד – live, עם המפתחות של מצב Live
PAYPAL_ENV=sandbox

PORT=3000
