# העתיקו לקובץ בשם .env ומלאו את הפרטים מ-https://developer.paypal.com/dashboard/applications
# (Apps & Credentials → צרו אפליקציה → Client ID + Secret)

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# sandbox = מצב בדיקות (כסף לא אמיתי). כשהכול עובד – live, עם המפתחות של מצב Live
PAYPAL_ENV=sandbox

PORT=3000

# מוכר/ת AI בחנות (Claude). מפתח מ-https://console.anthropic.com – נשאר רק בשרת
ANTHROPIC_API_KEY=

# מתחם הקניות (חנויות של עסקים במנוי חודשי)
# מזהה ה-Webhook מ-PayPal (Apps & Credentials → האפליקציה → Webhooks → Add Webhook
# לכתובת https://<האתר>/api/paypal/webhook עם האירועים BILLING.SUBSCRIPTION.* ו-PAYMENT.SALE.COMPLETED)
PAYPAL_WEBHOOK_ID=
# 0 = בלי חנויות לדוגמה במתחם
MALL_DEMO=1
# 1 = לבדיקות בלבד: פתיחת חנות בלי תשלום כשאין PayPal מוגדר. לעולם לא באתר אמיתי
MALL_DEMO_ACTIVATE=0
