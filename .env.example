# ===== S.Y LIVE SERVICE – deployment settings (copy to .env) =====
# DNS name that customers will open (must point to this server)
SY_DOMAIN=live.example.co.il
# Public IP of the server, if different from what SY_DOMAIN resolves to (optional)
PUBLIC_HOST=
# Email for Let's Encrypt notifications
ACME_EMAIL=admin@example.co.il

# Generate each secret with:  openssl rand -base64 48
POSTGRES_PASSWORD=
APP_SECRET=
MEDIAMTX_HOOK_SECRET=

# Allow creating additional businesses from the login screen (SaaS mode). The first business can always be created.
ALLOW_SIGNUP=false

# Optional ICE servers handed to browsers (JSON). Example with your own TURN server:
# ICE_SERVERS=[{"urls":"stun:live.example.co.il:3478"},{"urls":"turn:live.example.co.il:3478","username":"...","credential":"..."}]
ICE_SERVERS=[]
TURN_SECRET=

# Extra CORS origins (comma separated). The desktop app origins are allowed automatically.
CORS_ORIGINS=
MAX_UPLOAD_MB=1024
# Max size of one recording uploaded in chunks
MAX_RECORDING_MB=8192
LOG_LEVEL=info
